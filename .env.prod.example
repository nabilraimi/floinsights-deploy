# FloInsights — variables de PRODUCTION.
# Copier en .env.prod (JAMAIS commité) et remplir. Générer les secrets avec :
#   openssl rand -base64 32
# Les clés RS256 : bash ../api/scripts/generate-keys.sh (puis coller en base64).

# ─── Domaine & TLS ───
DOMAIN=app.floinsights.io
ACME_EMAIL=techops@semecity.com

# ─── Build web ───
# /v1 = relatif = same-origin (Caddy route /v1/* vers l'API). Ne pas mettre d'URL absolue.
NEXT_PUBLIC_API_URL=/v1

# ─── Base de données (host = nom du service compose : "postgres") ───
POSTGRES_USER=floinsights
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand
POSTGRES_DB=floinsights
# DATABASE_URL doit être LITTÉRAL (Prisma ne réexpanse pas ${...}).
# Garder user/password/db cohérents avec les 3 lignes ci-dessus.
DATABASE_URL=postgresql://floinsights:CHANGE_ME_openssl_rand@postgres:5432/floinsights?schema=public

# ─── Redis (host = "redis") ───
REDIS_PASSWORD=CHANGE_ME_openssl_rand
REDIS_URL=redis://:CHANGE_ME_openssl_rand@redis:6379

# ─── Auth RS256 (base64) ───
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_ME_openssl_rand
JWT_REFRESH_EXPIRES_IN=30d

# ─── Application ───
PORT=3008
NODE_ENV=production
API_PREFIX=v1
# Same-origin : le navigateur passe par Caddy, donc l'origine publique.
CORS_ORIGINS=https://app.floinsights.io

# ─── Analytics ───
ANALYTICS_ENGINE=postgres_native
ANALYTICS_CACHE_ENABLED=true
ANALYTICS_CACHE_TTL=120

# ─── Monitoring ───
SENTRY_DSN=
PROMETHEUS_PORT=9100

# ─── Stockage fichiers (Cloudflare R2). Laisser vide → fallback volume local ./uploads ───
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=floinsights-reports
R2_PUBLIC_URL=

# ─── Email (Resend) ───
RESEND_API_KEY=
EMAIL_FROM=FloInsights <reports@floinsights.io>

# ─── Super admin (créé UNE fois au 1er boot — voir CREATE_SUPER_ADMIN) ───
CREATE_SUPER_ADMIN=true
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=FloInsights
ADMIN_EMAIL=techops@semecity.com
ADMIN_PASSWORD=CHANGE_ME_strong

# ─── Sauvegarde (backup.sh → Hetzner Storage Box via rclone/scp) ───
BACKUP_RETENTION_DAYS=7
BACKUP_REMOTE=storagebox:floinsights-backups
