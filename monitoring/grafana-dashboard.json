{
  "__inputs": [
    {
      "name": "DS_PROM",
      "label": "Prometheus",
      "description": "Source de données Prometheus (Grafana Cloud).",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "title": "FloInsights — API (santé)",
  "uid": "floinsights-api",
  "tags": ["floinsights"],
  "schemaVersion": 38,
  "version": 1,
  "editable": true,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "DS_PROM",
        "label": "Datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      }
    ]
  },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "API — état (up)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "up{job=\"floinsights-api\"}", "datasource": { "type": "prometheus", "uid": "${DS_PROM}" } }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "1": { "text": "UP", "color": "green" }, "0": { "text": "DOWN", "color": "red" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Uptime process",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "time() - process_start_time_seconds{job=\"floinsights-api\"}", "datasource": { "type": "prometheus", "uid": "${DS_PROM}" } }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Mémoire RSS",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "process_resident_memory_bytes{job=\"floinsights-api\"}", "datasource": { "type": "prometheus", "uid": "${DS_PROM}" } }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Event-loop lag p99",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "nodejs_eventloop_lag_p99_seconds{job=\"floinsights-api\"}", "datasource": { "type": "prometheus", "uid": "${DS_PROM}" } }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 0.1 }, { "color": "red", "value": 0.2 } ] }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "CPU (cœurs)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        { "refId": "A", "expr": "rate(process_cpu_seconds_total{job=\"floinsights-api\"}[5m])", "legendFormat": "cpu", "datasource": { "type": "prometheus", "uid": "${DS_PROM}" } }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Mémoire (RSS vs heap)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        { "refId": "A", "expr": "process_resident_memory_bytes{job=\"floinsights-api\"}", "legendFormat": "RSS", "datasource": { "type": "prometheus", "uid": "${DS_PROM}" } },
        { "refId": "B", "expr": "nodejs_heap_size_used_bytes{job=\"floinsights-api\"}", "legendFormat": "heap utilisé", "datasource": { "type": "prometheus", "uid": "${DS_PROM}" } }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Event-loop lag (moyenne vs p99)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        { "refId": "A", "expr": "nodejs_eventloop_lag_seconds{job=\"floinsights-api\"}", "legendFormat": "moyenne", "datasource": { "type": "prometheus", "uid": "${DS_PROM}" } },
        { "refId": "B", "expr": "nodejs_eventloop_lag_p99_seconds{job=\"floinsights-api\"}", "legendFormat": "p99", "datasource": { "type": "prometheus", "uid": "${DS_PROM}" } }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Handles / requêtes actives",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        { "refId": "A", "expr": "nodejs_active_handles_total{job=\"floinsights-api\"}", "legendFormat": "handles", "datasource": { "type": "prometheus", "uid": "${DS_PROM}" } },
        { "refId": "B", "expr": "nodejs_active_requests_total{job=\"floinsights-api\"}", "legendFormat": "requests", "datasource": { "type": "prometheus", "uid": "${DS_PROM}" } }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    }
  ]
}
